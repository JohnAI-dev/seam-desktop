{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seam",
  "version": "0.1.0",
  "identifier": "dev.johnai.seam",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Seam",
        "width": 460,
        "height": 620,
        "minWidth": 360,
        "minHeight": 420
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Your phone and your computer, as one.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "adb",
          "scrcpy"
        ]
      }
    }
  }
}
